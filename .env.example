# Copy this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: set this to use a specific Gemini model
# MODEL_NAME=gemini-flash-lite-latest

# Optional: add your Paystack secret key to enable real payment links
# Get yours free at https://dashboard.paystack.com
# PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Optional: WhatsApp Meta Cloud API configuration
# WHATSAPP_TOKEN=your_meta_whatsapp_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
